VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef
# Opcional. Solo si Google Analytics esta habilitado en el proyecto Firebase.
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
# Opcional. Set "true" en .env.local cuando se quiera apuntar al Firebase
# Emulator Suite (firestore en 127.0.0.1:8080, auth en 127.0.0.1:9099). Las
# credenciales VITE_FIREBASE_* siguen siendo requeridas pero los valores no
# importan: el emulador acepta cualquiera.
VITE_USE_EMULATOR=false
